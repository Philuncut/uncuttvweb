# Required for POST /api/haendler/revalidate to succeed — header: x-revalidate-secret: <value>
# Leave empty locally if you do not use manual cache flush; production should set a long random string (Vercel + .env.local).
REVALIDATE_SECRET=

# Optional: JWT_AUTH_SECRET_KEY aus der wp-config.php des WordPress.
# Ist der Wert gesetzt, prueft der Shop Signatur und Ablauf jedes Tokens
# selbst und weist gefaelschte und abgelaufene Tokens ohne einen Aufruf
# nach WordPress ab. Ohne den Wert laeuft alles genauso, nur entscheidet
# dann allein WordPress ueber die Gueltigkeit.
WP_JWT_SECRET=

# Basis-URL des gemeinsamen Identitaetsdienstes (id.uncuttv.at), ohne
# Slash am Ende. Ueber ihn laufen Anmeldung und Passwortwechsel; er prueft
# die Zugangsdaten, setzt Passwoerter in WordPress und Supabase und liefert
# das WordPress-JWT, an dem die Sitzung des Shops haengt.
# Nur serverseitig, kein NEXT_PUBLIC_: Das Token bleibt httpOnly.
# Ohne den Wert ist keine Anmeldung moeglich. Es gibt bewusst keinen
# Rueckfall auf jwt-auth/v1/token; das waere die zweite Stelle, die es
# nicht mehr geben soll.
IDENTITY_URL=https://id.uncuttv.at

# Optional: gemeinsames Geheimnis, mit dem sich der Shop beim
# Identitaetsdienst als vertrauenswuerdiger Aufrufer ausweist
# (Kopfzeile X-UncutTV-Caller-Secret). Ist es gesetzt, gibt der Shop bei
# Anmeldung, Registrierung und Passwortwechsel die Adresse des Endnutzers
# mit (X-UncutTV-Client-IP, auf Vercel aus x-real-ip), und der Dienst
# zaehlt seine Grenze je Adresse gegen den Nutzer statt gegen die
# Ausgangsadresse von Vercel. Ohne den Wert schickt der Shop keine der
# beiden Kopfzeilen, und der Dienst zaehlt wie bisher. Muss mit dem Wert
# im Dienst uebereinstimmen.
IDENTITY_CALLER_SECRET=

# Verbund der drei Auftritte (@philuncut/universe): Wisch am Handy,
# Pfeilflaechen am Desktop, Reihenfolge streaming | shop | video. Das
# Bauteil rendert nur, wenn hier exakt "true" steht; sonst verhaelt es
# sich, als waere es nicht eingebaut. Der Wert wird zur BAUZEIT in den
# Code eingesetzt: Eine Aenderung in Vercel braucht ein neues Deployment,
# ein Neustart oder Reload reicht nicht. In Production vorerst false.
NEXT_PUBLIC_UNIVERSE_ENABLED=false
